{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://operator-key.local/schema/catalog.schema.json",
  "title": "Operator Key catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "host", "versions", "counts", "total", "conflicts", "entries"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.0.0"]},
    "generated_at": {"type": "string", "minLength": 1},
    "host": {"type": "string", "minLength": 1},
    "versions": {"$ref": "#/$defs/productMapString"},
    "counts": {"$ref": "#/$defs/productMapInteger"},
    "total": {"type": "integer", "minimum": 0},
    "conflicts": {
      "type": "array",
      "items": {"$ref": "#/$defs/conflict"}
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "productMapString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omarchy", "hermes", "claude-code", "codex"],
      "properties": {
        "omarchy": {"type": "string", "minLength": 1},
        "hermes": {"type": "string", "minLength": 1},
        "claude-code": {"type": "string", "minLength": 1},
        "codex": {"type": "string", "minLength": 1}
      }
    },
    "productMapInteger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omarchy", "hermes", "claude-code", "codex"],
      "properties": {
        "omarchy": {"type": "integer", "minimum": 0},
        "hermes": {"type": "integer", "minimum": 0},
        "claude-code": {"type": "integer", "minimum": 0},
        "codex": {"type": "integer", "minimum": 0}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "source", "version"],
      "properties": {
        "kind": {"type": "string", "enum": ["default", "override", "custom", "official"]},
        "status": {"type": "string", "enum": ["active", "disabled", "version-gated"]},
        "source": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product", "product_version", "interface", "task_group", "category", "command", "canonical_chord", "aliases", "description", "context", "safety_level", "destructive", "available", "conflict_ids", "source", "provenance"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "product": {"type": "string", "enum": ["omarchy", "hermes", "claude-code", "codex"]},
        "product_version": {"type": "string", "minLength": 1},
        "interface": {"type": "string", "enum": ["hotkey", "slash-command", "shell-command", "cli-flag", "menu-action"]},
        "task_group": {"type": "string", "enum": ["review-and-verify", "parallel-agents", "context-and-memory", "models-and-performance", "debug-and-recover", "sessions-and-navigation", "capture-and-input", "system-and-hardware", "configuration", "development", "help-and-reference"]},
        "category": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "canonical_chord": {"type": "string"},
        "aliases": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "description": {"type": "string", "minLength": 1},
        "context": {"type": "string"},
        "safety_level": {"type": "string", "enum": ["green", "amber", "red"]},
        "destructive": {"type": "boolean"},
        "available": {"type": "boolean"},
        "conflict_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/provenance"}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canonical_chord", "context", "entry_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "canonical_chord": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "entry_ids": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
